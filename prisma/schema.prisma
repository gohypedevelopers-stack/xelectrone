generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(CUSTOMER)
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  parentId     String? @map("parent_id")
  description  String?
  visible      Boolean @default(true)
  productCount Int     @default(0) @map("product_count")

  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  price          String
  oldPrice       String? @map("old_price")
  discount       String?
  rating         Float   @default(0)
  reviewsCount   String  @default("0") @map("reviews_count")
  description    String
  mainImage      String  @map("main_image")
  shippingNotice String  @map("shipping_notice")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  colors   ProductColor[]
  features ProductFeature[]
  specs    ProductSpec[]

  orderItems OrderItem[]

  @@map("products")
}

model ProductColor {
  id        String  @id @default(cuid())
  name      String
  bgHex     String  @map("bg_hex")
  borderHex String? @map("border_hex")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_colors")
}

model ProductFeature {
  id          String @id @default(cuid())
  featureText String @map("feature_text")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_features")
}

model ProductSpec {
  id    String @id @default(cuid())
  label String
  value String

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  total           Float
  shippingAddress String?     @map("shipping_address")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Float  @map("unit_price")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
